{
  "name": "ailouros-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Vue 3 frontend for the AIlourOS multi-agent orchestration UI.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:fix": "vite preview --wirte",
    "test": "vitest run",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,vue,json,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,json,css,html}\"",
    "audit:knip": "knip",
    "audit:deps": "depcruise --config .dependency-cruiser.cjs src",
    "audit:deps:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot src | dot -T svg -o ../var/artifacts/deps-graph.svg",
    "audit:jscpd": "jscpd --config .jscpd.json",
    "audit:types": "type-coverage --at-least 99 --strict --ignore-files 'src/**/*.test.ts'",
    "audit:types:detail": "type-coverage --at-least 99 --strict --detail --ignore-files 'src/**/*.test.ts'",
    "audit:mutation": "stryker run",
    "audit:openapi": "node scripts/check-openapi-drift.mjs",
    "audit:i18n": "node scripts/audit-i18n-keys.mjs",
    "ci": "npm run lint && npm run type-check && npm run test && npm run format && npm run build",
    "e2e": "npm run e2e:install && PLAYWRIGHT_BROWSERS_PATH=../var/playwright-browsers playwright test",
    "e2e:install": "PLAYWRIGHT_BROWSERS_PATH=../var/playwright-browsers playwright install --with-deps chromium",
    "e2e:report": "playwright show-report ../var/artifacts/e2e/report",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:preview": "tauri dev --no-watch"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "overrides": {
    "minimatch": "^10.2.3",
    "brace-expansion": "^5.0.6",
    "postcss": "^8.5.10",
    "js-cookie": "^3.0.7"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "d3": "^7.9.0",
    "dompurify": "^3.4.0",
    "marked": "^15.0.4",
    "pinia": "^2.3.1",
    "sortablejs": "^1.15.6",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.59.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/cli": "^2",
    "@types/d3": "^7.4.3",
    "@types/sortablejs": "^1.15.8",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-sonarjs": "^3.0.7",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jscpd": "^4.2.3",
    "jsdom": "^29.0.2",
    "knip": "^6.14.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.4.2",
    "type-coverage": "^2.29.7",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.4",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.0"
  }
}
